{
  "name": "qa-context",
  "version": "1.0.0",
  "private": true,
  "description": "Point it at a web app - its source and a running instance - and get one analysis.json: every screen, every control, a proven locator for each, and the API behind them. Context an LLM can write tests from.",
  "keywords": [
    "playwright",
    "test-automation",
    "qa",
    "app-analysis",
    "llm-context",
    "crawler",
    "claude-code",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "author": "Tsvetomir Banovski",
  "homepage": "https://github.com/banovski1/qa-context#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banovski1/qa-context.git"
  },
  "bugs": {
    "url": "https://github.com/banovski1/qa-context/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "preflight": "node scripts/setup/preflight.mjs",
    "crawl:map": "node .claude/skills/app-explorer/lib/map.mjs",
    "crawl:deep": "node .claude/skills/app-explorer/lib/explore.mjs",
    "verify-auth": "tsx scripts/api-auth/verify-auth.ts",
    "record:ingest": "tsx scripts/analysis/ingest-recording.ts",
    "compile": "tsx scripts/model-compiler/compile-model.ts",
    "check": "tsx scripts/model-compiler/check-model.ts",
    "app:worktree": "node scripts/worktree/new-app.mjs",
    "pipeline:test": "tsx --test scripts/config/*.test.mjs .claude/skills/app-explorer/lib/*.test.mjs scripts/model-compiler/__tests__/*.test.ts scripts/analysis/__tests__/*.test.ts scripts/api-auth/__tests__/*.test.ts",
    "pipeline:typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
